# Copie para .env e preencha. O .env nunca vai para o repositório.

# ------------------------------ servidor ------------------------------
PORT=3000
NODE_ENV=development
MAX_PER_ROOM=15

# ------------------------------ Supabase ------------------------------
# Painel do projeto → Settings → API

# URL do projeto, algo como https://abcdefghijk.supabase.co
SUPABASE_URL=

# Chave "anon / public". Vai para o NAVEGADOR, é pública por natureza —
# ela só serve para o login. Sem RLS liberado ela não lê tabela nenhuma.
SUPABASE_ANON_KEY=

# Chave "service_role". SEGREDO. Passa por cima de RLS e só existe aqui no
# servidor. Se ela vazar, vazou o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → API → JWT Settings → JWT Secret. Usada para conferir, sem ida
# à rede, se o token que o navegador mandou foi mesmo o Supabase que assinou.
SUPABASE_JWT_SECRET=

# Settings → Database → Connection string → modo "Transaction pooler"
# (porta 6543). O pooler não aceita prepared statement, e o código já sobe
# com isso desligado.
DATABASE_URL=

# ------------------------------ TURN (opcional) ------------------------------
# Só necessário se alguém do grupo não conseguir conectar — costuma ser
# rede de celular ou corporativa. Aceita várias URLs separadas por vírgula.
TURN_URL=
TURN_USER=
TURN_PASS=

# ------------------------------ AdSense (opcional) ------------------------------
# Anúncio no rodapé da coluna da direita. Precisa de um site aprovado no
# AdSense (adsense.google.com) com uma unidade de anúncio criada — os dois
# valores abaixo vêm de lá. Sem os dois, nenhum anúncio aparece nem nenhum
# script de fora é carregado.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
